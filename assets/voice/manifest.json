  "point.glute-max-A": {
   "en": "One leg up, drive your hips up with your glutes",
   "zh": "一条腿抬起，用臀部把身体推高"
  },
  "point.h-9090-liftoff": {
   "en": "Sit tall, lift the back knee slowly, then lower it slowly",
   "zh": "坐直，后腿膝盖慢慢抬离地面，再慢慢放下"
  },
  "point.h-adductor-rock": {
   "en": "One leg out to the side, sit your hips back slowly",
   "zh": "一条腿向侧面伸直，臀部慢慢往后坐"
  },
  "point.h-band-hip-ir": {
   "en": "Keep the knee still, turn the shin outward",
   "zh": "膝盖不动，小腿向外转"
  },
  "point.h-band-leg-out": {
   "en": "Keep the leg straight and lower it out to the side",
   "zh": "腿伸直，慢慢向外侧落下"
  },
  "point.h-butterfly-active": {
   "en": "Soles together, open the knees slowly and bring them back",
   "zh": "脚心相对，膝盖慢慢打开再收回"
  },
  "point.h-couch-stretch": {
   "en": "Back foot up, squeeze your glutes, hips forward",
   "zh": "后脚搭高，收紧臀部，髋往前送"
  },
  "point.h-hip-gate": {
   "en": "Hold the chair, lift the knee and circle it open",
   "zh": "扶住椅子，膝盖抬高，向外画圈打开"
  },
  "point.h-knee-hug": {
   "en": "Hug your knees and breathe slowly",
   "zh": "双手抱膝，慢慢呼吸"
  },
  "point.h-quad-cars": {
   "en": "On all fours, draw a big circle with the knee, keep the low back still",
   "zh": "四点跪姿，膝盖画一个尽量大的圈，腰不要动"
  },
  "point.h-reverse-clam": {
   "en": "Knees together, lift the shin up slowly",
   "zh": "膝盖并拢，小腿慢慢向上抬"
  },
  "point.h-squat": {
   "en": "Heels down, knees track over the toes",
   "zh": "脚跟踩稳，膝盖对准脚尖"
  },
  "point.h-sumo-pry": {
   "en": "Sit low and gently press the knees out with your elbows",
   "zh": "蹲低，手肘把膝盖轻轻向外推"
  },
  "point.h-supine-twist": {
   "en": "Drop both knees to one side, shoulders stay down",
   "zh": "双膝倒向一侧，肩膀贴地"
  },
  "point.h-wall-straddle": {
   "en": "Legs up the wall, let them fall open to the sides",
   "zh": "腿靠墙，让双腿自然向两侧打开"
  },
  "point.hip-flexors-A": {
   "en": "Sit tall, lift the straight leg, pause, then lower",
   "zh": "坐直，腿伸直抬起，停一下再放下"
  },
  "point.n-chair-wiper": {
   "en": "Seated, swing the shin out and let the knee fall in",
   "zh": "坐在椅子上，小腿向外摆，膝盖向内倒"
  },
  "point.n-half-split": {
   "en": "Front leg straight, fold from the hips, hands on the blocks",
   "zh": "前腿伸直，从髋部往前折，手扶砖"
  },
  "point.n-leg-circles": {
   "en": "Leg straight, draw slow circles, pelvis still",
   "zh": "腿伸直，慢慢画圈，骨盆不动"
  },
  "point.n-pelvis-circle": {
   "en": "Feet still, draw slow circles with your pelvis",
   "zh": "双脚不动，骨盆慢慢画圈"
  },
  "point.n-prone-hip-ext": {
   "en": "Lying face down, knee bent, lift the thigh slowly",
   "zh": "趴着，屈膝，大腿慢慢抬离地面"
  },
  "point.n-prone-ir": {
   "en": "Lying face down, knees bent, let the shins fall outward",
   "zh": "趴着，屈膝，小腿向外侧摆"
  },
  "point.n-seated-ir-drop": {
   "en": "Hands behind you, drop one knee inward",
   "zh": "手在身后撑地，一侧膝盖向内倒"
  },
  "point.n-seated-knee-lift": {
   "en": "Sit tall, lift the knee and hold it there",
   "zh": "坐直，膝盖抬起，悬停住"
  },
  "point.n-seated-squeeze": {
   "en": "Squeeze the block between your knees",
   "zh": "双膝夹住瑜伽砖，用力夹紧"
  },
  "point.n-slider-lateral": {
   "en": "Slide one foot out to the side and pull it back",
   "zh": "一只脚向侧面滑出去，再收回来"
  },
  "point.n-squat-shift": {
   "en": "Stay low and shift your weight side to side",
   "zh": "低蹲，重心慢慢左右移"
  },
  "point.n-straddle-fold": {
   "en": "Sit tall in a straddle and lean forward from the hips",
   "zh": "分腿坐直，从髋部慢慢往前倾"
  },
  "point.n-thomas-test": {
   "en": "Hug one knee, let the other leg rest straight",
   "zh": "抱住一边膝盖，另一条腿放松伸直"
  },
  "point.n-wide-fold": {
   "en": "Feet wide, hold the chair, fold from the hips",
   "zh": "双脚分开，扶住椅子，从髋部往前折"
  },
  "point.n-windshield": {
   "en": "Let both knees fall side to side, shoulders down",
   "zh": "双膝一起慢慢左右倒，肩膀贴地"
  },
  "point.o-seated-fig4": {
   "en": "Ankle on the knee, keep the back straight and lean forward",
   "zh": "脚踝搭在膝盖上，背挺直往前压"
  },
  "point.o-seated-ham": {
   "en": "Leg straight, toes up, lean forward with a straight back",
   "zh": "腿伸直，脚尖勾起，背挺直往前"
  },
  "point.o-stand-crossreach": {
   "en": "Cross one leg behind and reach up and over",
   "zh": "一条腿交叉到后面，手臂向上向侧面伸"
  },
  "point.o-stand-lunge": {
   "en": "Hold the chair, squeeze the back glute, hips forward",
   "zh": "扶住椅子，后侧臀部收紧，髋往前推"
  },
  "point.s-9090": {
   "en": "Both legs at right angles, sit tall, then switch sides",
   "zh": "两条腿都成直角，坐直，再左右换"
  },
  "point.s-butterfly": {
   "en": "Soles together, sit tall, let the knees drop",
   "zh": "脚心对脚心，坐直，让膝盖自然落下"
  },
  "point.s-figure4": {
   "en": "Ankle over the other knee, pull the legs toward your chest",
   "zh": "脚踝搭在另一侧膝盖上，把腿拉向胸口"
  },
  "point.s-frog": {
   "en": "Knees wide, toes out, sit your hips back slowly",
   "zh": "膝盖向两侧打开，脚尖朝外，臀部慢慢往后坐"
  },
  "point.s-kneel-hipflex": {
   "en": "Squeeze the back glute and ease the hips forward",
   "zh": "后侧臀部收紧，髋慢慢往前推"
  },
  "point.s-lizard": {
   "en": "Front foot outside your hand, sink the hips",
   "zh": "前脚放在手外侧，髋往下沉"
  },
  "point.s-pigeon": {
   "en": "Stay upright, hands on the blocks, sink the hips",
   "zh": "上身立直，手扶砖，髋往下沉"
  },
  "point.s-seated-fold": {
   "en": "Knees straight, fold forward from the hips",
   "zh": "膝盖伸直，从髋部往前折"
  },
  "point.t-seated-straddle-lift-1leg": {
   "en": "Sit tall in a straddle and lift one leg off the floor",
   "zh": "分腿坐直，一条腿抬离地面"
  },
  "point.w-clamshell": {
   "en": "Heels together, open the knee like a clamshell",
   "zh": "脚跟并拢，膝盖像贝壳一样打开"
  },
  "point.w-feet-on-chair-bridge": {
   "en": "Feet on the chair, drive your hips up",
   "zh": "脚踩椅面，用臀部把身体推高"
  },
