 "lines": {
  "a.choose": {
   "en": "Okay. Which picture looks like you? Pick one",
   "zh": "好，看看你像哪一张，选一个"
  },
  "a.cue.butterfly": {
   "en": "Soles together, sit tall and let the knees drop on their own.",
   "zh": "脚心对脚心，坐直，让膝盖自己往下落。"
  },
  "a.cue.deep_squat": {
   "en": "Heels down, squat as low as you can and hold for three seconds. Keep a chair nearby.",
   "zh": "脚跟踩稳，慢慢蹲到最低，停 3 秒。旁边放把椅子，不稳就扶。"
  },
  "a.cue.ninety_ninety": {
   "en": "Both legs at right angles, hands off the floor, sit tall.",
   "zh": "两条腿都摆成直角，手离开地面，坐直。"
  },
  "a.cue.seated_fold": {
   "en": "Knees straight, fold from the hips and walk your hands down your legs.",
   "zh": "膝盖别弯，从屁股那里往前折，手顺着腿往前走。"
  },
  "a.cue.supine_cross": {
   "en": "Lift one straight leg and cross it over. Hand on your hip bone, stop as soon as it moves.",
   "zh": "一条腿伸直抬起来，往另一边跨过去。手按胯骨，胯骨一动就停。"
  },
  "a.cue.thomas": {
   "en": "Hug one knee, let the other leg rest straight, and slide your hand under that knee.",
   "zh": "抱住一边膝盖，另一条腿放松伸直，把手塞到膝盖下面试试。"
  },
  "a.done": {
   "en": "Check complete. Here are your results",
   "zh": "自测完成，来看看你的结果"
  },
  "a.hold": {
   "en": "Hold it and notice how it feels",
   "zh": "保持住，感受一下"
  },
  "a.intro": {
   "en": "Hip check, six moves. Follow each one, then pick the picture that looks most like you.",
   "zh": "开胯体检，一共 6 项。每项跟着做一遍，再选一张最像你的图。"
  },
  "a.item.butterfly": {
   "en": "Move one: Butterfly",
   "zh": "第一项，蝴蝶式"
  },
  "a.item.deep_squat": {
   "en": "Move six: Deep squat",
   "zh": "第六项，深蹲到底"
  },
  "a.item.ninety_ninety": {
   "en": "Move two: Ninety ninety",
   "zh": "第二项，90 90"
  },
  "a.item.seated_fold": {
   "en": "Move five: Seated forward fold",
   "zh": "第五项，坐姿体前屈"
  },
  "a.item.supine_cross": {
   "en": "Move four: Lying leg cross",
   "zh": "第四项，仰卧横跨"
  },
  "a.item.thomas": {
   "en": "Move three: Hip flexor test",
   "zh": "第三项，屈髋肌测试"
  },
  "a.left_first": {
   "en": "Left side first",
   "zh": "先测左边"
  },
  "a.switch_right": {
   "en": "Left side saved. Now the right side",
   "zh": "左边记好了，换右边"
  },
  "cue.control.1": {
   "en": "Slow down, stay in control",
   "zh": "慢一点，控制住"
  },
  "cue.control.2": {
   "en": "Keep the pelvis still, move from the hip",
   "zh": "骨盆稳住，只动髋"
  },
  "cue.extra_left": {
   "en": "One extra set on the left",
   "zh": "左边多做一组"
  },
  "cue.extra_right": {
   "en": "One extra set on the right",
   "zh": "右边多做一组"
  },
  "cue.flexibility.1": {
   "en": "Breathe out and sink a little deeper",
   "zh": "呼气，再沉一点"
  },
  "cue.flexibility.2": {
   "en": "Hold still, no bouncing",
   "zh": "保持住，不要弹震"
  },
  "cue.half_range": {
   "en": "Half the range, only go where it does not hurt",
